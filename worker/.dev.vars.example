# Copy to .dev.vars for `wrangler dev`. The Vite dev server (port 5173)
# proxies /api here, so auth runs on the Vite origin.
BETTER_AUTH_SECRET=generate-a-long-random-string
BETTER_AUTH_URL=http://localhost:5173
# Google OAuth web client; add http://localhost:5173/api/auth/callback/google
# as a redirect URI for local sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Sender address on the Cloudflare Email Sending domain. Locally, emails are
# not sent; wrangler dev prints where it saved each one.
EMAIL_FROM=noreply@marketing.kabooly.com
FOUNDER_LOGIN_EMAIL=webdigga42@gmail.com
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Shared with the kabooly.com checkout and the CRM worker for /api/internal/*.
INTERNAL_API_SECRET=generate-a-long-random-string
# Signing secret of this worker's Stripe webhook endpoint.
STRIPE_WEBHOOK_SECRET=
